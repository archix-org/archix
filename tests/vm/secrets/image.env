# Sourced by build-image.sh: a partition after the root, vda3, which the test makes its swap and greps raw (its type isn't swap, which systemd would turn on before mkswap), the consumers' tools, and the guest's leak sweep beside the config.
partitions='label: gpt\nsize=1G, type=uefi\nsize=6G, type=linux\ntype=linux, name=archix-swap\n'
packages+=(age wireguard-tools networkmanager strace openssl arch-install-scripts)
after_image() {
  install -Dm755 /vm/secrets/archix-leak-sweep /mnt/etc/archix/archix-leak-sweep
}
