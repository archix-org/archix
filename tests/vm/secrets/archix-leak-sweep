#!/bin/bash
# Usage: archix-leak-sweep MARKERS; the guest side of the secrets suite's leak sweep: each marker of MARKERS ("name value" lines), raw or base64, in every file of the trees that persist, in the compressed streams of UKIs and initramfs images, in the journal and in core dumps; prints "HIT name place" for each find.
set -uo pipefail
export LC_ALL=C
markers=$1
work=$(dirname "$markers")
declare -A values
while read -r name value; do values[$name]=$value; done < "$markers"
patterns=$work/patterns
for name in "${!values[@]}"; do
  printf '%s\n' "${values[$name]}"
  printf '%s' "${values[$name]}" | base64 -w0
  echo
done > "$patterns"
# Which markers a file (or stdin, with -) holds.
which_in() {
  local place=$1 file=$2 name b64
  for name in "${!values[@]}"; do
    b64=$(printf '%s' "${values[$name]}" | base64 -w0)
    grep -qaF -e "${values[$name]}" -e "$b64" "$file" 2> /dev/null && echo "HIT $name $place"
  done
}
for dir in /archix /etc /var /efi /boot /root /home /srv /opt /usr /mnt; do
  [ -d "$dir" ] || continue
  grep -rlaF -f "$patterns" "$dir" 2> /dev/null | while read -r file; do which_in "$file" "$file"; done
done
find /efi /archix/deploy/*/boot -type f 2> /dev/null | while read -r image; do
  grep -obUaP '\x28\xb5\x2f\xfd|\x1f\x8b\x08' "$image" 2> /dev/null | cut -d: -f1 | head -200 | while read -r at; do
    tail -c +$((at + 1)) "$image" | { zstd -dcq 2> /dev/null || tail -c +$((at + 1)) "$image" | gzip -dc 2> /dev/null; } > "$work/stream" || true
    [ -s "$work/stream" ] && which_in "$image (stream at byte $at)" "$work/stream"
    rm -f "$work/stream"
  done
done
journalctl -o export --no-pager > "$work/journal" 2> /dev/null
which_in "the journal" "$work/journal"
rm -f "$work/journal"
for core in /var/lib/systemd/coredump/*; do
  [ -f "$core" ] || continue
  zstdcat "$core" > "$work/core" 2> /dev/null || cp "$core" "$work/core"
  which_in "$core" "$work/core"
  rm -f "$work/core"
done
rm -f "$patterns"
