# Sourced by build-image.sh: two kernels at the older snapshot, which the test updates from; its glibc is older than the build host's, which the static build archix-static (gone with 9381bee) ran on, so the image fails until archix is built against this snapshot's glibc.
date=2026-06-01 size=16G
packages+=(linux-lts)
install_archix() {
  echo "build-image.sh: the $date image's glibc is older than the one archix was built against, and archix-static is gone; this suite needs an archix built for it" >&2
  exit 1
}
