#!/bin/bash
# boot-real DEV: boots DEV for real in nested QEMU with no NIC, its serial console in /dev/shm/boot.log, and prints how many seconds it took; BOOT_TIMEOUT only stops a hung boot, as check-point judges the time against the pristine image's.
. /etc/archix-powercut.conf
cp /usr/share/edk2/x64/OVMF_VARS.4m.fd /dev/shm/vars.fd
started=$SECONDS
timeout "${BOOT_TIMEOUT:-3600}" qemu-system-x86_64 -enable-kvm -cpu host -m 2048 -smp 2 -machine q35 \
  -drive if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd -drive if=pflash,format=raw,unit=1,file=/dev/shm/vars.fd \
  -drive file="$1",format=raw,if=virtio,cache=none -nic none -display none -serial file:/dev/shm/boot.log -monitor none > /dev/null 2>&1
echo $((SECONDS - started))
