#!/usr/bin/env python3
# io-compare A1 A2 B1 B2: io-tokens of two runs of build A and two of build B, as flush epochs: at each flush (an empty one or a write's preflush) the regions written since the last, and each FUA write by region, which is the order a power cut can see, and each ESP epoch's writes in order, which the replay's ESP subsets are drawn from; exits 1 when a run of A and one of B differ by more than A's or B's two runs do, in the whole sequence, the ESP's or the root's part of it, or the ESP epochs' writes.
import collections
import difflib
import sys


def epochs(path):
    seq, written = [], set()
    for line in open(path):
        region, kind, tags = line.split()[:3]
        tags = tags.split(",")
        if kind == "flush" or "flush" in tags:
            seq.append("flush after " + ("+".join(sorted(written)) or "nothing"))
            written = set()
        if kind != "flush":
            written.add(region + (":meta" if "meta" in tags else ""))
        if "fua" in tags:
            seq.append("fua " + region)
    if written:
        seq.append("unflushed " + "+".join(sorted(written)))
    return seq


def esp_only(seq):
    return [e for e in seq if "esp" in e]


def distance(a, b):
    return 1 - difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()


names = ["A1", "A2", "B1", "B2"]
runs = {name: epochs(path) for name, path in zip(names, sys.argv[1:5])}
for name, path in zip(names, sys.argv[1:5]):
    counts = collections.Counter(" ".join(line.split()[:3]) for line in open(path))
    print(f"{name} ({path.rsplit('-', 2)[-2]}): {len(runs[name])} epochs, {sum(e.startswith('flush') for e in runs[name])} flushes, {sum(e.startswith('fua') for e in runs[name])} FUA; " + ", ".join(f"{n} {k}" for k, n in sorted(counts.items())))
ok = True
for label, view in (("all", lambda s: s), ("ESP", esp_only), ("root", lambda s: [e for e in s if "root" in e])):
    same = {p: distance(view(runs[p[0]]), view(runs[p[1]])) for p in (("A1", "A2"), ("B1", "B2"))}
    cross = {p: distance(view(runs[p[0]]), view(runs[p[1]])) for p in (("A1", "B1"), ("A2", "B2"), ("A1", "B2"), ("A2", "B1"))}
    print(f"{label} epochs, distance (1 - difflib ratio): same build " + ", ".join(f"{a}/{b} {d:.4f}" for (a, b), d in same.items()) + "; across builds " + ", ".join(f"{a}/{b} {d:.4f}" for (a, b), d in cross.items()))
    if min(cross.values()) > max(same.values()):
        ok = False
        print(f"{label}: every run of A differs from every run of B by more than either build's runs differ")
    a, b = view(runs["A1"]), view(runs["B1"])
    shown = 0
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != "equal" and shown < 6:
            shown += 1
            print(f"{label} A1/B1 {tag} at {i1}: {a[i1:i2][:4]} -> {b[j1:j2][:4]}")

def esp_windows(path):
    """How many ESP writes each flush window that has any holds, which is what the replay's ESP subsets are drawn from."""
    counts, n = [], 0
    for line in open(path):
        region, kind, tags = line.split()[:3]
        if kind == "flush" or "flush" in tags.split(","):
            if n:
                counts.append(n)
            n = 0
        if region == "esp":
            n += 1
    return counts + ([n] if n else [])


windows = {name: esp_windows(path) for name, path in zip(names, sys.argv[1:5])}
for a, b in (("A1", "A2"), ("B1", "B2"), ("A1", "B1")):
    differ = sum(x != y for x, y in zip(windows[a], windows[b])) + abs(len(windows[a]) - len(windows[b]))
    print(f"ESP flush windows {a}/{b}: {len(windows[a])} and {len(windows[b])}, {differ} with another number of ESP writes; {a} {windows[a][:24]}, {b} {windows[b][:24]}")


def esp_epoch_writes(path):
    """Each flush epoch's ESP writes, in order, as (sector from the ESP's start, length, flags)."""
    found, writes = [], []
    for line in open(path):
        region, kind, tags, start, length = line.split()
        if kind == "flush" or "flush" in tags.split(","):
            if writes:
                found.append(writes)
            writes = []
        if region == "esp" and kind != "flush":
            writes.append((int(start), int(length), tags))
    return found + ([writes] if writes else [])


ordered = {name: esp_epoch_writes(path) for name, path in zip(names, sys.argv[1:5])}
unlike = {}
for a, b in (("A1", "A2"), ("B1", "B2"), ("A1", "B1"), ("A2", "B2"), ("A1", "B2"), ("A2", "B1")):
    same = reordered = other = 0
    first = None
    for i, (x, y) in enumerate(zip(ordered[a], ordered[b])):
        if x == y:
            same += 1
            continue
        if sorted(x) == sorted(y):
            reordered += 1
        else:
            other += 1
        first = first if first is not None else i
    extra = abs(len(ordered[a]) - len(ordered[b]))
    unlike[(a, b)] = reordered + other + extra
    print(f"ESP epochs' writes {a}/{b}: {len(ordered[a])} and {len(ordered[b])} epochs; {same} the same writes in the same order, {reordered} the same writes in another order, {other} other writes, {extra} unmatched" + (f"; first unlike epoch {first}: {ordered[a][first][:6]} -> {ordered[b][first][:6]}" if first is not None else ""))
if min(unlike[p] for p in (("A1", "B1"), ("A2", "B2"), ("A1", "B2"), ("A2", "B1"))) > max(unlike[("A1", "A2")], unlike[("B1", "B2")]):
    ok = False
    print("ESP epochs' writes: every run of A differs from every run of B by more than either build's runs differ")
sys.exit(0 if ok else 1)
