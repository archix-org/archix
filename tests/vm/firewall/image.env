# Sourced by build-image.sh: sshd and nft, and a key the host side of the test logs in with, its private half kept outside the image.
packages+=(openssh nftables)
after_image() {
  arch-chroot /mnt ssh-keygen -q -t ed25519 -N '' -f /root/vmtest-key
  mv /mnt/root/vmtest-key /work/ssh-key && chmod 600 /work/ssh-key
  install -Dm600 /mnt/root/vmtest-key.pub /mnt/root/.ssh/authorized_keys && rm /mnt/root/vmtest-key.pub
  # The probe NIC has no DHCP server; without its static addresses the plain image's wait-online would time out on it.
  printf '[Match]\nMACAddress=52:54:00:12:34:77\n\n[Network]\nAddress=192.168.77.2/24\nAddress=198.51.100.2/24\nAddress=fd00:77::2/64\nAddress=2001:db8::2/64\nIPv6AcceptRA=no\n' > /mnt/etc/systemd/network/10-probe.network
}
