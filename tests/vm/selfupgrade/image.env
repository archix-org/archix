# Sourced by build-image.sh: archix-git built from the last deployments-model commit (old) is installed from a local repo, and this tree's (new) waits beside it for the test to publish.
packages=(base linux mkinitcpio systemd-ukify)
size=12G
install_archix() {
  useradd -r builder 2> /dev/null || true
  mkdir -p /mnt/srv/archix-repo /mnt/srv/archix-next
  local which version build
  for which in old new; do
    build=$(mktemp -d)
    version=$(cat "/work/$which/version")
    sed "s/^pkgver=.*/pkgver=$version/" "$dir/PKGBUILD" > "$build/PKGBUILD"
    cp "/work/$which/archix" "$build/archix" && cp "/work/$which/archix-static" "$build/archix-static"
    chown -R builder "$build"
    runuser -u builder -- bash -c "cd $build && makepkg --nodeps > /dev/null"
    cp "$build/archix-git-$version-1-x86_64.pkg.tar.zst" "/mnt/srv/archix-next/$which.pkg.tar.zst"
    cp "/work/$which/version" "/mnt/srv/archix-next/$which.version"
    cp "/work/$which/commit" "/mnt/srv/archix-next/$which.commit"
  done
  cp /mnt/srv/archix-next/old.pkg.tar.zst "/mnt/srv/archix-repo/archix-git-$(cat /work/old/version)-1-x86_64.pkg.tar.zst"
  repo-add -q /mnt/srv/archix-repo/archix-self.db.tar.gz /mnt/srv/archix-repo/archix-git-*.pkg.tar.zst
  arch-chroot /mnt pacman -U --noconfirm /srv/archix-next/old.pkg.tar.zst > /dev/null
}
