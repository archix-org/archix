# Sourced by build-image.sh: CachyOS as it installs, its live repos ahead of Arch's with x86-64-v3 builds, linux-cachyos, and Limine as the boot loader (kernel and initramfs on the ESP) instead of systemd-boot.
date=2026-10-16 size=12G
packages=(base linux-cachyos mkinitcpio systemd-ukify cachyos-keyring htop jq sbctl git e2fsprogs limine efibootmgr)
before_pacstrap() {
  python - /tmp/pacman.conf <<'PY'
import re, sys
path = sys.argv[1]
text = open(path).read()
repos = "".join(f"[{r}]\nServer = https://mirror.cachyos.org/repo/x86_64_v3/$repo\n\n" for r in ("cachyos-v3", "cachyos-core-v3", "cachyos-extra-v3"))
repos += "[cachyos]\nServer = https://mirror.cachyos.org/repo/x86_64/$repo\n\n"
text = text.replace("[core]", repos + "[core]", 1)
text = re.sub(r"^#?Architecture = .*$", "Architecture = x86_64 x86_64_v3", text, count=1, flags=re.M)
open(path, "w").write(text)
PY
  local keyring
  keyring=$(mktemp -d)
  curl -sfo "$keyring/keyring.pkg.tar.zst" https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-keyring-20240331-1-any.pkg.tar.zst
  bsdtar -xf "$keyring/keyring.pkg.tar.zst" -C "$keyring" usr/share/pacman/keyrings
  pacman-key --init > /dev/null 2>&1
  pacman-key --populate-from "$keyring/usr/share/pacman/keyrings" --populate cachyos > /dev/null
}
after_pacstrap() {
  arch-chroot /mnt pacman-key --populate archlinux cachyos > /dev/null
}
# Limine at EFI/limine and the removable path, booting the kernel and initramfs copied to the ESP; the test gives it a firmware entry, as CachyOS's installer does.
after_image() {
  rm -rf /mnt/efi/EFI/systemd /mnt/efi/EFI/Linux /mnt/efi/loader /mnt/efi/EFI/BOOT
  install -Dm644 /mnt/usr/share/limine/BOOTX64.EFI /mnt/efi/EFI/limine/BOOTX64.EFI
  install -Dm644 /mnt/usr/share/limine/BOOTX64.EFI /mnt/efi/EFI/BOOT/BOOTX64.EFI
  # autodetect would keep only the build host's modules.
  arch-chroot /mnt mkinitcpio -k "$kernel" -S autodetect -g /boot/initramfs-linux-cachyos.img
  cp /mnt/boot/vmlinuz-linux-cachyos /mnt/boot/initramfs-linux-cachyos.img /mnt/efi/
  printf 'timeout: 0\n\n/CachyOS\n    protocol: linux\n    path: boot():/vmlinuz-linux-cachyos\n    module_path: boot():/initramfs-linux-cachyos.img\n    cmdline: %s\n' "$(cat /mnt/etc/kernel/cmdline)" > /mnt/efi/limine.conf
  ls -R /mnt/efi
}
