# Sourced by build-image.sh: CachyOS as its installer leaves it, its live repos ahead of Arch's with x86-64-v3 builds, linux-cachyos, zlib-ng-compat for zlib, ufw enabled, cachyos-hooks' os-release, no systemd-ukify, btrfs subvolumes @ @home @root @srv @cache @tmp @log, and Limine as the boot loader (kernel and initramfs on the ESP) instead of systemd-boot.
date=2026-11-13 size=12G
packages=(base linux-cachyos mkinitcpio systemd-ukify cachyos-keyring cachyos-hooks htop jq sbctl git e2fsprogs limine efibootmgr ufw sudo)
before_pacstrap() {
  python - /tmp/pacman.conf <<'PY'
import re, sys
path = sys.argv[1]
text = open(path).read()
repos = "".join(f"[{r}]\nServer = https://mirror.cachyos.org/repo/x86_64_v3/$repo\n\n" for r in ("cachyos-v3", "cachyos-core-v3", "cachyos-extra-v3"))
repos += "[cachyos]\nServer = https://mirror.cachyos.org/repo/x86_64/$repo\n\n"
text = text.replace("[core]", repos + "[core]", 1)
text = re.sub(r"^#?Architecture = .*$", "Architecture = x86_64 x86_64_v3", text, count=1, flags=re.M)
open(path, "w").write(text)
PY
  local keyring
  keyring=$(mktemp -d)
  curl -sfo "$keyring/keyring.pkg.tar.zst" https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-keyring-20240331-1-any.pkg.tar.zst
  bsdtar -xf "$keyring/keyring.pkg.tar.zst" -C "$keyring" usr/share/pacman/keyrings
  pacman-key --init > /dev/null 2>&1
  pacman-key --populate-from "$keyring/usr/share/pacman/keyrings" --populate cachyos > /dev/null
}
after_pacstrap() {
  arch-chroot /mnt pacman-key --populate archlinux cachyos > /dev/null
  # --ask 4 answers the conflict question with yes, as zlib-ng-compat replaces base's zlib.
  arch-chroot /mnt pacman -S --noconfirm --ask 4 zlib-ng-compat > /dev/null
  arch-chroot /mnt /usr/share/libalpm/scripts/cachyos-branding os-release
  sed -i 's/^ENABLED=.*/ENABLED=yes/' /mnt/etc/ufw/ufw.conf
  arch-chroot /mnt systemctl enable ufw.service
}
# Limine at EFI/limine and the removable path, booting the kernel and initramfs copied to the ESP; the test gives it a firmware entry, as CachyOS's installer does.
after_image() {
  rm -rf /mnt/efi/EFI/systemd /mnt/efi/EFI/Linux /mnt/efi/loader /mnt/efi/EFI/BOOT
  install -Dm644 /mnt/usr/share/limine/BOOTX64.EFI /mnt/efi/EFI/limine/BOOTX64.EFI
  install -Dm644 /mnt/usr/share/limine/BOOTX64.EFI /mnt/efi/EFI/BOOT/BOOTX64.EFI
  # autodetect would keep only the build host's modules.
  arch-chroot /mnt mkinitcpio -k "$kernel" -S autodetect -g /boot/initramfs-linux-cachyos.img
  cp /mnt/boot/vmlinuz-linux-cachyos /mnt/boot/initramfs-linux-cachyos.img /mnt/efi/
  printf 'timeout: 0\n\n/CachyOS\n    protocol: linux\n    path: boot():/vmlinuz-linux-cachyos\n    module_path: boot():/initramfs-linux-cachyos.img\n    cmdline: %s\n' "$(cat /mnt/etc/kernel/cmdline)" > /mnt/efi/limine.conf
  ls -R /mnt/efi
  # The build needed it for the plain UKI; CachyOS doesn't install it.
  arch-chroot /mnt pacman -R --noconfirm systemd-ukify > /dev/null
  local top fsuuid pair
  top=$(mktemp -d)
  mount "$root" "$top"
  fsuuid=$(blkid -s UUID -o value "$root")
  echo "UUID=$fsuuid / btrfs subvol=/@,defaults,noatime,compress=zstd 0 0" >> /mnt/etc/fstab
  for pair in /home:@home /root:@root /srv:@srv /var/cache:@cache /var/tmp:@tmp /var/log:@log; do
    btrfs -q subvolume create "$top/${pair#*:}"
    chmod --reference="/mnt${pair%%:*}" "$top/${pair#*:}"
    cp -a "/mnt${pair%%:*}/." "$top/${pair#*:}/"
    find "/mnt${pair%%:*}" -mindepth 1 -delete
    echo "UUID=$fsuuid ${pair%%:*} btrfs subvol=/${pair#*:},defaults,noatime,compress=zstd 0 0" >> /mnt/etc/fstab
  done
  umount "$top"
  sed -i "s/@FS_UUID@/$fsuuid/g" /mnt/etc/archix/init.lua
  cat /mnt/etc/fstab
}
