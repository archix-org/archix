---
interface Props {
	command: string;
	label: string;
}

const { command, label } = Astro.props;
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Words never break inside; URLs may break after a slash.
const html = command
	.split(' ')
	.map((word) => (word.includes('/') ? escape(word).replace(/\//g, '/<wbr>') : `<span class="word">${escape(word)}</span>`))
	.join(' ');
---

<div class="copy">
	<pre aria-label={label}><code><span class="prompt" aria-hidden="true">$ </span><Fragment set:html={html} /></code></pre>
	<button type="button" data-copy={command}>Copy</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(button.dataset.copy!);
			button.textContent = 'Copied';
			setTimeout(() => (button.textContent = 'Copy'), 1600);
		});
	}
</script>

<style>
	.copy {
		display: flex;
		align-items: stretch;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--term-bg);
		overflow: hidden;
	}
	pre {
		flex: 1;
		min-width: 0;
		margin: 0;
		padding: 0.85rem 1rem;
		white-space: normal;
		color: var(--term-text);
		font-size: 0.78rem;
		line-height: 1.5;
	}
	.prompt {
		color: var(--term-mist);
	}
	pre :global(.word) {
		white-space: nowrap;
	}
	button {
		flex: none;
		padding-inline: 1rem;
		border: 0;
		border-left: 1px solid var(--line);
		background: transparent;
		color: var(--term-text);
		font: 600 0.8rem var(--display);
		cursor: pointer;
	}
	button:hover {
		background: #16263c;
	}
</style>
