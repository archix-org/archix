---
import { Code } from 'astro:components';
import { archixTheme } from '../lib/code-theme';

const config = `return {
  imports = { "modules.common", "modules.gaming" },

  repos = { "core", "extra", "multilib" },
  packages = { "steam", "mangohud", "obs-studio", "protonup-qt" },

  programs = {
    kitty = {
      enable = true,
      font = { name = "JetBrainsMono Nerd Font", size = archix.force(11) },
    },
  },
}`;

const generations = [
	{ n: 38, date: 'Sep 18' },
	{ n: 39, date: 'Sep 25' },
	{ n: 40, date: 'Oct 02' },
	{ n: 41, date: 'Oct 09' },
	{ n: 42, date: 'Oct 15' },
];
---

<div class="demo" data-demo>
	<div class="panes">
		<figure class="pane">
			<figcaption><span>lua/hosts/desktop.lua</span></figcaption>
			<Code code={config} lang="lua" theme={archixTheme as any} />
		</figure>
		<figure class="pane term">
			<figcaption>
				<span>terminal</span>
				<span class="keys" aria-hidden="true">press <kbd>U</kbd> / <kbd>R</kbd></span>
			</figcaption>
			<div class="screen" aria-live="polite" data-screen>
				<p><span class="cmd">archix status</span></p>
				<p class="out">generation 41 · locked to 2026-10-09 · clean</p>
			</div>
			<div class="controls">
				<button type="button" data-action="update"><kbd>U</kbd><span data-label>archix update</span></button>
				<button type="button" data-action="rollback" disabled><kbd>R</kbd>archix rollback</button>
			</div>
		</figure>
	</div>

	<div class="rail" style="--at: 3">
		<ol aria-label="Generations">
			{
				generations.map((g) => (
					<li class:list={{ future: g.n === 42 }} data-gen={g.n}>
						<span class="gen">{g.n}</span>
						<span class="date">{g.date}</span>
					</li>
				))
			}
		</ol>
		<div class="anchor" aria-hidden="true">
			<svg viewBox="340 220 344 470" width="18" height="24"><circle cx="512" cy="289" r="51" fill="none" stroke="currentColor" stroke-width="46"></circle><rect x="484" y="340" width="56" height="332" fill="currentColor"></rect><rect x="357" y="392" width="310" height="56" fill="currentColor"></rect></svg>
		</div>
		<p class="visually-hidden" data-rail-status>Current generation: 41</p>
	</div>
</div>

<script>
	type Line = [text: string, kind?: 'cmd' | 'out' | 'ok' | 'bad' | 'note'];

	const update: Line[] = [
		['archix update', 'cmd'],
		['  lock      2026-10-09 → 2026-10-15'],
		['  packages  212 upgraded · mesa 25.2.4 → 25.3.0'],
		['  aur       3 rebuilt in a clean chroot'],
		['  prepare   ✓ downloaded, built, checked', 'ok'],
		['  apply     ✓ generation 42 is live', 'ok'],
		['steam', 'cmd'],
		['Segmentation fault (core dumped)', 'bad'],
	];
	const rollback: Line[] = [
		['archix rollback', 'cmd'],
		['  btrfs     restored the snapshot of generation 41'],
		['  ✓ back on generation 41 in 3.8s', 'ok'],
		['steam', 'cmd'],
		['# launches fine. generation 42 stays around until you gc it', 'note'],
	];

	const root = document.querySelector<HTMLElement>('[data-demo]')!;
	const screen = root.querySelector<HTMLElement>('[data-screen]')!;
	const rail = root.querySelector<HTMLElement>('.rail')!;
	const status = root.querySelector<HTMLElement>('[data-rail-status]')!;
	const updateButton = root.querySelector<HTMLButtonElement>('[data-action="update"]')!;
	const updateLabel = updateButton.querySelector<HTMLElement>('[data-label]')!;
	const rollbackButton = root.querySelector<HTMLButtonElement>('[data-action="rollback"]')!;
	const gen42 = root.querySelector<HTMLElement>('[data-gen="42"]')!;
	const initial = screen.innerHTML;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const wait = (ms: number) => new Promise((r) => setTimeout(r, still ? 0 : ms));

	let state: 'idle' | 'busy' | 'updated' | 'rolledBack' = 'idle';

	async function print(lines: Line[]) {
		for (const [text, kind = 'out'] of lines) {
			const p = document.createElement('p');
			if (kind === 'cmd') {
				const span = document.createElement('span');
				span.className = 'cmd';
				p.append(span);
				screen.append(p);
				for (const ch of text) {
					span.textContent += ch;
					await wait(28);
				}
				await wait(260);
			} else {
				p.className = kind;
				p.textContent = text;
				screen.append(p);
				await wait(150);
			}
			screen.scrollTop = screen.scrollHeight;
		}
	}

	function moveAnchor(at: number, gen: number) {
		rail.style.setProperty('--at', String(at));
		status.textContent = `Current generation: ${gen}`;
	}

	async function run(action: 'update' | 'rollback') {
		if (state === 'busy') return;
		if (action === 'update') {
			if (state === 'rolledBack') {
				screen.innerHTML = initial;
				gen42.classList.add('future');
				gen42.classList.remove('kept');
				moveAnchor(3, 41);
				updateLabel.textContent = 'archix update';
			} else if (state !== 'idle') return;
			state = 'busy';
			updateButton.disabled = true;
			await print(update.slice(0, 6));
			gen42.classList.remove('future');
			moveAnchor(4, 42);
			await print(update.slice(6));
			state = 'updated';
			rollbackButton.disabled = false;
			rollbackButton.focus({ preventScroll: true });
		} else {
			if (state !== 'updated') return;
			state = 'busy';
			rollbackButton.disabled = true;
			await print(rollback.slice(0, 2));
			moveAnchor(3, 41);
			gen42.classList.add('kept');
			await print(rollback.slice(2));
			state = 'rolledBack';
			updateLabel.textContent = 'replay';
			updateButton.disabled = false;
		}
	}

	updateButton.addEventListener('click', () => run('update'));
	rollbackButton.addEventListener('click', () => run('rollback'));
	document.addEventListener('keydown', (e) => {
		if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, textarea')) return;
		if (e.key === 'u' || e.key === 'U') run('update');
		if (e.key === 'r' || e.key === 'R') run('rollback');
	});
</script>

<style>
	.panes {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--term-bg);
		overflow: hidden;
		box-shadow: 0 30px 80px -40px rgb(23 147 209 / 0.45);
	}
	.pane {
		display: flex;
		flex-direction: column;
		min-width: 0;
		margin: 0;
	}
	.term {
		border-left: 1px solid #233650;
	}
	figcaption {
		display: flex;
		justify-content: space-between;
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid #233650;
		color: var(--term-mist);
		font: 0.7rem var(--mono);
		font-stretch: 87.5%;
	}
	kbd {
		display: inline-grid;
		place-items: center;
		min-width: 1.4em;
		padding: 0.05em 0.3em;
		border: 1px solid #34496a;
		border-radius: 4px;
		color: #d8e4ef;
		font-size: 0.95em;
	}
	.pane :global(pre) {
		flex: 1;
		margin: 0;
		padding: 1.1rem 1.2rem 1.3rem;
		font-size: 0.74rem;
		line-height: 1.75;
		overflow-x: auto;
	}
	.screen {
		flex: 1;
		height: 19rem;
		padding: 1.1rem 1.2rem 0.5rem;
		overflow-y: auto;
		color: #d8e4ef;
		font: 0.74rem/1.75 var(--mono);
		font-stretch: 87.5%;
	}
	.screen :global(p) {
		margin: 0;
		white-space: pre-wrap;
	}
	.screen :global(.cmd)::before {
		content: '$ ';
		color: var(--term-mist);
	}
	.screen :global(.cmd) {
		color: #ffffff;
	}
	.screen :global(.out) {
		color: #b5c4d4;
	}
	.screen :global(.ok) {
		color: #6fd6a8;
	}
	.screen :global(.bad) {
		color: #ff6b4a;
		font-weight: 600;
	}
	.screen :global(.note) {
		color: var(--term-mist);
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 0.9rem 1.2rem 1.1rem;
	}
	.controls button {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.85rem;
		border: 1px solid #34496a;
		border-radius: 8px;
		background: #16263c;
		color: #ffffff;
		font: 0.72rem var(--mono);
		font-stretch: 87.5%;
		cursor: pointer;
		transition: background 0.15s, border-color 0.15s, opacity 0.15s;
	}
	.controls button:hover:not(:disabled) {
		border-color: var(--hull);
		background: #1b3150;
	}
	.controls button:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.controls button[data-action='rollback']:not(:disabled) {
		border-color: var(--hull);
		animation: pulse 1.6s ease-in-out infinite;
	}
	@keyframes pulse {
		50% {
			box-shadow: 0 0 0 5px rgb(23 147 209 / 0.25);
		}
	}

	.rail {
		position: relative;
		margin-top: 1.6rem;
		padding-top: 2.4rem;
	}
	.rail ol {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 3px solid var(--hull);
	}
	.rail li {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: 0.6rem;
		position: relative;
		transition: opacity 0.3s;
	}
	.rail li::before {
		content: '';
		position: absolute;
		top: -8px;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--ink-0);
		border: 3px solid var(--hull);
	}
	.rail li.future {
		opacity: 0.3;
	}
	.rail li.future::before {
		border-style: dashed;
	}
	.rail li.kept .gen::after {
		content: ' kept';
		color: var(--mist);
		font-weight: 400;
	}
	.gen {
		font: 650 0.95rem var(--display);
		font-stretch: 115%;
	}
	.date {
		color: var(--mist);
		font: 0.68rem var(--mono);
		font-stretch: 87.5%;
	}
	.anchor {
		position: absolute;
		top: 0;
		left: 0;
		width: 20%;
		display: flex;
		justify-content: center;
		color: var(--ring);
		transform: translateX(calc(var(--at) * 100%));
		transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
	}

	@media (max-width: 820px) {
		.panes {
			grid-template-columns: 1fr;
		}
		.term {
			border-left: 0;
			border-top: 1px solid #233650;
		}
		.screen {
			height: 16rem;
		}
		.keys {
			display: none;
		}
	}
</style>
