# Maintainer: archix contributors <https://github.com/archix-org/archix>
pkgname=archix
pkgver=0.2.0
pkgrel=1
pkgdesc="Declarative, lockable, rollback-able system configuration for Arch Linux"
arch=('x86_64')
url="https://archix.dev"
license=('GPL-3.0-only')
depends=('pacman' 'libgcc' 'glibc')
makedepends=('rust')
optdepends=(
  'git: AUR packages and recording the config commit'
  'devtools: building AUR packages in a clean chroot'
  'flatpak: Flatpak apps'
)
# Other AUR packages ship their own /usr/bin/ax.
conflicts=('ax')
source=("https://github.com/archix-org/archix/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
# packaging/aur/pin.sh fills these in from the release.
sha256sums=('2b3582d91672fbc5392f2f7a5e837625093c6211d4687cdfb2bdb2292e4efc0e')
# makepkg's LTO turns the bundled C libraries (zstd, Lua) into GCC bytecode the Rust linker can't read.
options=('!lto' '!debug')

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cd "$pkgname-$pkgver"
  cargo test --frozen --release --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/archix "$pkgdir/usr/bin/archix"
  ln -s archix "$pkgdir/usr/bin/ax"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 packaging/archix.sysusers "$pkgdir/usr/lib/sysusers.d/archix.conf"
}
