# Maintainer: archix contributors <https://github.com/archix-org/archix>
pkgname=archix-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Declarative, lockable, rollback-able system configuration for Arch Linux (prebuilt)"
arch=('x86_64')
url="https://archix.dev"
license=('MIT OR Apache-2.0')
depends=('pacman' 'gcc-libs' 'glibc')
optdepends=(
  'git: AUR packages and recording the config commit'
  'devtools: building AUR packages in a clean chroot'
  'mkinitcpio: boot entries'
  'systemd-ukify: boot entries'
  'sbctl: signing boot entries for Secure Boot'
  'btrfs-progs: snapshots before each switch'
  'flatpak: Flatpak apps'
)
provides=('archix')
conflicts=('archix' 'ax')
source=("https://github.com/archix-org/archix/releases/download/v$pkgver/archix-$pkgver-x86_64-linux.tar.gz"{,.sig})
# packaging/aur/pin.sh fills these in from the signed release.
sha256sums=('9ef304bccca04dcd75263316a34dd611071a0e355a852bc100b896fcbe43ff1b' 'SKIP')
validpgpkeys=('CE9A595A3355AE955DEE7BB415374E7E35BAF667')

package() {
  cd "archix-$pkgver-x86_64-linux"
  install -Dm755 archix "$pkgdir/usr/bin/archix"
  ln -s archix "$pkgdir/usr/bin/ax"
  install -Dm755 archix-static "$pkgdir/usr/lib/archix/archix-static"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/archix"
}
